export EDITOR='nvim'

if [ -d "/opt/homebrew/bin" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
fi

if [ -d "/home/linuxbrew" ]; then
    export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
    export HOMEBREW_CELLAR="/home/linuxbrew/.linuxbrew/Cellar"
    export HOMEBREW_REPOSITORY="/home/linuxbrew/.linuxbrew/Homebrew"

    export PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:$PATH"

    if [ -n "$MANPATH" ]; then
        export MANPATH=":$MANPATH"
    fi
    case ":$INFOPATH:" in
    *:/home/linuxbrew/.linuxbrew/share/info:*) ;;
    *) export INFOPATH="/home/linuxbrew/.linuxbrew/share/info:$INFOPATH" ;;
    esac

    export RUBY_CONFIGURE_OPTS="--with-openssl-dir=$(brew --prefix openssl@3)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

export PATH="$HOME/.local/bin:$PATH"

export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"

export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"

# Authenticate Bundler to GitHub Packages using the active gh account.
# The token remains managed by gh instead of being committed to this repository.
if command -v gh >/dev/null 2>&1; then
  github_username="$(gh auth status --json hosts --jq '.hosts["github.com"][] | select(.active) | .login' 2>/dev/null || true)"
  github_token="$(gh auth token --hostname github.com 2>/dev/null || true)"

  if [ -n "$github_username" ] && [ -n "$github_token" ]; then
    export BUNDLE_RUBYGEMS__PKG__GITHUB__COM="${github_username}:${github_token}"
  fi

  unset github_username github_token
fi
